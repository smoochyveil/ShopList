<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ShopList.Maui.ViewsModels"
             xmlns:models="clr-namespace:ShopList.Maui.Models"
             x:Class="ShopList.Maui.Views.MainPage"
             Title="Listas de compras">

    <Grid>
        <CollectionView
            Margin="8"
            BackgroundColor="Black"
            EmptyView="Aún no se han registrado elementos en la lista"
            ItemsSource="{Binding Items}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type models:ShopListItem}">

                    <Border
                        Stroke="DarkGray"
                        StrokeThickness="1"
                        Padding="5">

                        <Grid ColumnDefinitions="3*,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="{Binding Nombre}"
                                FontSize="20"
                                TextColor="White"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="{Binding Cantidad}"
                                FontSize="20"
                                TextColor="White"
                                VerticalOptions="Center"/>

                            <HorizontalStackLayout
                                Grid.Column="2"
                                VerticalOptions="Center">

                                <CheckBox
                                    IsChecked="{Binding Comprado}"/>

                                <Label
                                    Text="Comprado"
                                    TextColor="White"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        <Button
            Command="{Binding ShowNewItemFormCommand}"
            Text="+"
            WidthRequest="56"
            HeightRequest="56"
            FontSize="24"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="16"/>
    </Grid>
</ContentPage>
